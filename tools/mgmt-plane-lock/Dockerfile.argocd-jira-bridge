FROM golang:1.24.3 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/argocd-jira-bridge ./cmd/argocd-jira-bridge

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/argocd-jira-bridge /app/argocd-jira-bridge
USER nonroot:nonroot
ENTRYPOINT ["/app/argocd-jira-bridge"]
